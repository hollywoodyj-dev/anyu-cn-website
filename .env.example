# 复制为 .env.local 后填入；勿提交真实密钥（见 AGENTS.md）
# Vercel：Project → Settings → Environment Variables（Production / Preview），保存后 Redeploy。
OPENAI_API_KEY=

# 可选；默认 gpt-5.4（API 别名；可改为快照如 gpt-5.4-2026-03-05）
# JSON 与 SSE（Accept: text/event-stream 或 body stream:true）共用同一模型。
ANYU_OPENAI_CHAT_MODEL=gpt-5.4

# 可选；覆盖默认安语 system prompt 时用整段文本
# ANYU_SYSTEM_PROMPT=

# 可选；与 prompt 变更同步 bump
ANYU_PROMPT_VERSION=v0

# 可选；风险规则集版本号（见 lib/anyu/risk/evaluate.ts）
# ANYU_RISK_RULES_VERSION=risk-v0

# 持久化 session / 历史（Prisma Postgres）
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# ANYU_CHAT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Step 9：服务端 utterance STT（默认 bridge：设备侧转写后直传 message）---
# bridge（转发到外部 STT） | openai_whisper | off
# ANYU_STT_PROVIDER=bridge
# bridge 模式：设置 STT 服务地址（可收 multipart `audio`/`file`，返回 text/transcript/result）
# ANYU_BRIDGE_STT_URL=
# 可选：鉴权 token（默认用 Authorization: Bearer <token>）
# ANYU_BRIDGE_STT_TOKEN=
# 可选：token 头名（如 X-API-Key）
# ANYU_BRIDGE_STT_TOKEN_HEADER=Authorization
# 可选：上游超时（毫秒，默认 20000）
# ANYU_BRIDGE_STT_TIMEOUT_MS=20000
# 可选：bridge 模式文件大小上限（字节，默认 10485760=10MB）
# ANYU_BRIDGE_STT_MAX_BYTES=10485760
# ANYU_OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Step 10：/cn 免责 cookie 门（本地自动化可设 1 跳过）---
# ANYU_SKIP_DISCLAIMER_MIDDLEWARE=
