generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ElderChatSession {
  id        String          @id
  locale    String          @default("zh")
  style     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  turns     ElderChatTurn[]
}

model ElderChatTurn {
  id        String           @id @default(cuid())
  sessionId String
  session   ElderChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  turnIndex Int
  mode      String?
  style     String?
  riskLevel String?
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
}

model ConversationSignal {
  id                 String   @id @default(cuid())
  elderUserId        String
  sessionId          String?
  emotion            String
  mentionsFamily     Boolean  @default(false)
  healthSignal       Boolean  @default(false)
  indirectExpression Boolean  @default(false)
  riskLevel          String
  keywords           String[]
  memoryCandidate    String?
  suggestedAction    String?
  createdAt          DateTime @default(now())

  @@index([elderUserId, createdAt])
}

model DailySummary {
  id              String   @id @default(cuid())
  elderUserId     String
  date            String
  overallState    String
  familyMentions  Int      @default(0)
  lonelinessScore Int      @default(0)
  healthSignals   Int      @default(0)
  riskLevel       String
  keyMessages     String[]
  suggestedAction String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([elderUserId, date])
  @@index([elderUserId, date])
}

model MemoryCard {
  id          String   @id @default(cuid())
  elderUserId String
  content     String
  tag         String
  saved       Boolean  @default(false)
  source      String   @default("signal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([elderUserId, createdAt])
}

model FamilyNotification {
  id          String   @id @default(cuid())
  elderUserId String
  childUserId String?
  level       String
  title       String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([elderUserId, createdAt])
}
